    "test:unit": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@playwright/test": "^1.28.1",
    "@skeletonlabs/skeleton": "^4.7.4",
    "@skeletonlabs/skeleton-svelte": "^4.7.4",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.9.1",
    "svelte": "^5.45.6",
    "svelte-check": "^3.4.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
